# NetGuard Monit - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values. DO NOT commit .env to version control.

# ============================================================================
# ADMINISTRATION
# ============================================================================
# Generate a secure password: PowerShell: $b=New-Object byte[] 36;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
APP_ADMIN_PASSWORD=replace-with-a-unique-16-character-minimum-password

# This must be the hostname users type in their browser (from Cloudflare Tunnel hostname).
# For development/testing with direct access, use "localhost" or your machine's hostname.
# NEVER use "*" - be specific for security.
APP_TRUSTED_HOSTS=monitor.example.com

# Session settings
APP_SESSION_TTL_HOURS=8
APP_ALERT_COOLDOWN_MINUTES=240
APP_RETENTION_DAYS=30

# Display timezone for dashboard timestamps and charts (IANA name).
APP_TIMEZONE=Asia/Jakarta

# ============================================================================
# ROUTEROS CONFIGURATION
# ============================================================================
# RouterOS REST must remain private/LAN-only. A private IPv4/IPv6 literal is required.
# This is the LAN IP address of your MikroTik router.
MIKROTIK_BASE_URL=https://192.168.88.1

# Create a dedicated read-only account on RouterOS for monitoring
MIKROTIK_USERNAME=netguard-readonly
MIKROTIK_PASSWORD=replace-with-router-readonly-password

# The WAN interface name as shown in RouterOS (e.g., ether1, wan1, etc.)
MIKROTIK_WAN_INTERFACE=ether1

# TLS verification:
# - "true" to use system CA bundle (works with Let's Encrypt certs)
# - "false" to skip verification (NOT recommended for production)
# - "/data/certs/router-ca.pem" for custom CA certificate
MIKROTIK_TLS_VERIFY=true

# Polling interval in seconds (5-3600)
MIKROTIK_POLL_INTERVAL_SECONDS=5

# CPU alert threshold (percentage)
MIKROTIK_CPU_ALERT_PERCENT=85

# ============================================================================
# COLLECTION METHOD
# ============================================================================
# rest (RouterOS REST API), snmp (SNMPv2c), or both
MIKROTIK_COLLECT_METHOD=rest

# Required when collect_method is snmp or both
# MIKROTIK_SNMP_HOST=192.168.88.1
# MIKROTIK_SNMP_COMMUNITY=public

# ============================================================================
# ALERT THRESHOLDS
# ============================================================================
# DDoS detection threshold for WAN interface (in bps)
DDOS_THRESHOLD_BPS=100000000

# Broadcast/storm detection threshold (drops per poll interval)
BROADCAST_THRESHOLD_PPS=1000

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================
# Leave both blank to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# DDoS DETECTION CONFIGURATION
# ============================================================================
# Enable/disable DDoS detection engine
DDOS_DETECTION_ENABLED=true

# Detection profile: sensitive (2σ), balanced (3σ), or conservative (4σ)
DDOS_PROFILE=balanced

# SAFETY: Always keep dry_run=true for first 30 days of testing
DDOS_DRY_RUN=true

# Enable auto-mitigation (requires DDOS_DRY_RUN=false)
DDOS_AUTOMITIGATE=false

# Baseline smoothing factor (0.1-0.5, lower = more stable)
DDOS_EWMA_ALPHA=0.3

# Minimum stddev floor for quiet links (prevents division issues)
DDOS_MIN_STDDEV_BPS=100000

# Days before seasonal baselines become active
DDOS_WARMUP_DAYS=7

# Minimum seconds between mitigation actions
DDOS_MITIGATION_COOLDOWN_SECONDS=300

# Detection weight multipliers (must sum to 1.0)
DDOS_WEIGHT_BPS=0.30
DDOS_WEIGHT_PPS=0.25
DDOS_WEIGHT_DROPS=0.15
DDOS_WEIGHT_NEWCONN=0.20
DDOS_WEIGHT_SYNRATIO=0.10

# ============================================================================
# PING MONITORING (latency & packet loss)
# ============================================================================
# Enable/disable ping probes
PING_ENABLED=true

# Comma-separated list of targets to ping (IP addresses or hostnames)
PING_TARGETS=8.8.8.8,1.1.1.1,192.168.88.1

# Number of ICMP echo requests per poll
PING_COUNT=4

# Timeout per probe in seconds
PING_TIMEOUT_SECONDS=5.0

# Latency alert threshold (ms)
PING_LATENCY_ALERT_MS=100.0

# Packet loss alert threshold (percent)
PING_PACKET_LOSS_ALERT_PERCENT=50.0

# ============================================================================
# CLOUDFLARE TUNNEL
# ============================================================================
# Create a remotely managed Cloudflare Tunnel at:
# https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
# Paste the tunnel token here (the tunnel connects outbound; no port forwarding needed)
CLOUDFLARE_TUNNEL_TOKEN=tunnel_token_here
